{
	"name": "hcl-lsp",
	"displayName": "Terragrunt Language Server",
	"description": "VSCode extension for Terragrunt HCL language support",
	"author": "Bahram Shamshiri",
	"license": "MIT",
	"version": "0.1.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/jowharshamshiri/tg-hcl-lsp"
	},
	"publisher": "bahramjoharshamshiri",
	"categories": [],
	"keywords": [
		"terragrunt", "hcl", "lsp"
	],
	"engines": {
		"vscode": "^1.52.0"
	},
	"activationEvents": [
		"onLanguage:terragrunt"
	],
	"main": "./client/out/extension",
	"icon": "./icon.png",
	"contributes": {
		"grammars": [
			{
				"language": "terragrunt",
				"scopeName": "source.hcl",
				"path": "./terragrunt.tmLanguage.json"
			}
		],
		"languages": [
			{
				"id": "terragrunt",
				"extensions": [
					".hcl",
					".tfvars"
				],
				"configuration": "./language-configuration.json",
				"aliases": [
					"Terragrunt",
					"HCL"
				]
			}
		],
		"configuration": {
			"type": "object",
			"title": "Terragrunt LSP Configuration",
			"properties": {
				"tg-hcl-lsp.enable": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Controls the enablement."
				},
				"tg-hcl-lsp.options": {
					"scope": "resource",
					"type": "object",
					"default": {},
					"description": "Additional options."
				},
				"tg-hcl-lsp.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "on",
					"description": "Traces the communication between VSCode and the language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd .."
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^5.2.0",
		"@types/node": "^20",
		"eslint": "^9.13.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.16.0"
	},
	"dependencies": {
		"tghclparser": "0.1.5"
	}
}

{
    "name": "hcl-lsp",
    "displayName": "Terragrunt Language Server",
    "description": "VSCode extension for Terragrunt HCL language support",
    "author": "Bahram Shamshiri",
    "license": "MIT",
    "version": "0.2.2",
    "repository": {
        "type": "git",
        "url": "https://github.com/jowharshamshiri/tg-hcl-lsp"
    },
    "publisher": "bahramjoharshamshiri",
    "categories": [],
    "keywords": [
        "terragrunt",
        "hcl",
        "lsp"
    ],
    "engines": {
        "vscode": "^1.52.0"
    },
    "activationEvents": [
        "onLanguage:terragrunt"
    ],
    "main": "./dist/extension.js",
    "icon": "./icon.png",
    "contributes": {
        "commands": [
            {
                "command": "terragrunt.evaluateFunction",
                "title": "Evaluate Terragrunt Function",
                "enableCommandUris": true
            },
            {
                "command": "terragrunt.dependencyTree",
                "title": "Show Terragrunt Dependency Tree",
                "enableCommandUris": true
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "terragrunt.dependencyTree",
                    "when": "editorLangId == terragrunt",
                    "group": "terragrunt@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "terragrunt.evaluateFunction",
                    "when": "editorLangId == terragrunt"
                },
                {
                    "command": "terragrunt.dependencyTree",
                    "when": "editorLangId == terragrunt"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Terragrunt Language Server",
            "properties": {
                "terragrunt.codeLens.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable code lens for function evaluation"
                }
            }
        },
        "grammars": [
            {
                "language": "terragrunt",
                "scopeName": "source.hcl",
                "path": "./terragrunt.tmLanguage.json"
            }
        ],
        "languages": [
            {
                "id": "terragrunt",
                "extensions": [
                    ".hcl",
                    ".tfvars"
                ],
                "configuration": "./language-configuration.json",
                "aliases": [
                    "Terragrunt",
                    "HCL"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run webpack:prod",
        "webpack:prod": "webpack --mode production",
        "webpack:dev": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "lint": "eslint",
        "postinstall": "cd client && npm install && cd ../server && npm install && cd .."
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@stylistic/eslint-plugin": "^2.9.0",
        "@types/mocha": "^5.2.0",
        "@types/node": "^20",
        "copy-webpack-plugin": "^12.0.2",
        "eslint": "^9.13.0",
        "ts-loader": "^9.5.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.16.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "tghclparser": "0.3.6",
        "vscode-uri": "^3.1.0"
    }
}

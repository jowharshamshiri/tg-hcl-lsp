{
    "name": "hcl-lsp",
    "displayName": "Terragrunt Language Server",
    "description": "VSCode extension for Terragrunt HCL language support",
    "author": "Bahram Shamshiri",
    "license": "MIT",
    "version": "{{ project.version }}",
    "repository": {
        "type": "git",
        "url": "https://github.com/jowharshamshiri/tg-hcl-lsp"
    },
    "publisher": "bahramjoharshamshiri",
    "categories": [],
    "keywords": [
        "terragrunt",
        "hcl",
        "lsp"
    ],
    "engines": {
        "vscode": "^1.97.0"
    },
    "activationEvents": [
        "onLanguage:terragrunt"
    ],
    "main": "./dist/extension.js",
    "icon": "./icon.png",
    "contributes": {
        "commands": [
            {
                "command": "terragrunt.dependencyTree",
                "title": "Show Terragrunt Lineage Graph",
                "enableCommandUris": true
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "terragrunt.dependencyTree",
                    "when": "editorLangId == terragrunt",
                    "group": "terragrunt@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "terragrunt.dependencyTree",
                    "when": "editorLangId == terragrunt"
                }
            ]
        },
        "grammars": [
            {
                "language": "terragrunt",
                "scopeName": "source.hcl",
                "path": "./terragrunt.tmLanguage.json"
            }
        ],
        "languages": [
            {
                "id": "terragrunt",
                "extensions": [
					".hcl"
                ],
                "configuration": "./language-configuration.json",
                "aliases": [
                    "Terragrunt",
                    "HCL"
                ]
            }
        ]
    },
	"scripts": {
        "vscode:prepublish": "cross-env BUILD_MODE=production webpack",
        "webpack": "webpack",
        "watch": "cross-env BUILD_MODE=development webpack --watch --stats detailed",
        "lint": "eslint",
        "dev": "npm run watch"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@stylistic/eslint-plugin": "^2.9.0",
        "@types/mocha": "^5.2.0",
        "@types/node": "^22.12.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^7.0.3",
        "dotenv": "^16.4.7",
        "eslint": "^9.39.0",
        "ts-loader": "^9.5.2",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.46.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "vscode-uri": "^3.1.0"
    }
}

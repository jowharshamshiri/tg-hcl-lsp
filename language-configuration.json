{
	"comments": {
	  "lineComment": "#",
	  "blockComment": ["/*", "*/"]
	},
	"brackets": [
	  ["{", "}"],
	  ["[", "]"],
	  ["(", ")"]
	],
	"autoClosingPairs": [
	  { "open": "{", "close": "}" },
	  { "open": "[", "close": "]" },
	  { "open": "(", "close": ")" },
	  { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
	  { "open": "${", "close": "}" }
	],
	"surroundingPairs": [
	  ["{", "}"],
	  ["[", "]"],
	  ["(", ")"],
	  ["\"", "\""],
	  ["${", "}"]
	],
	"indentationRules": {
	  "increaseIndentPattern": "^.*(?:\\{|\\[|\\()\\s*$",
	  "decreaseIndentPattern": "^\\s*[}\\])]"
	},
	"onEnterRules": [
	  {
		"beforeText": "^\\s*#.*",
		"action": { "indent": "none", "appendText": "# " }
	  },
	  {
		"beforeText": "^\\s*[a-zA-Z_][a-zA-Z0-9_-]*(?:\\s+\"[^\"]+\")?\\s*\\{\\s*$",
		"action": { "indent": "increase" }
	  },
	  {
		"beforeText": "^\\s*\\}",
		"action": { "indent": "decrease" }
	  },
	  {
		"beforeText": "<<(\\w+)",
		"afterText": "^\\1$",
		"action": {
		  "indent": "none",
		  "appendText": "\n  ",
		  "removeText": 0
		}
	  }
	],
	"wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
	"folding": {
	  "markers": {
		"start": "^\\s*\\/\\*\\*?\\s*#region",
		"end": "^\\s*\\/\\*\\*?\\s*#endregion"
	  }
	}
  }

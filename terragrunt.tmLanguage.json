{
	"name": "Terragrunt",
	"scopeName": "source.hcl",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#blocks"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#user_defined_variables"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#heredocs"
		}
	],
	"repository": {
		"attributes": {
			"patterns": [
				{
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_-]*\\b(?=\\s*=)",
					"name": "support.type.property-name.hcl"
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"match": "#.*$",
					"name": "comment.line.number-sign.hcl"
				},
				{
					"begin": "/\\*",
					"end": "\\*/",
					"name": "comment.block.hcl"
				}
			]
		},
		"blocks": {
			"patterns": [
				{
					"match": "\\b(terraform|extra_arguments|include|dependency|dependencies|locals|remote_state|generate|before_hook|after_hook|error_hook|catalog|engine|feature|exclude|errors|retry|ignore|unit|stack|autoinclude)\\b",
					"name": "keyword.control.hcl"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"match": "\\$\\{[^\\}]*\\}",
					"name": "variable.other.hcl"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.hcl",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.hcl",
							"match": "\\\\."
						}
					]
				}
			]
		},
		"user_defined_variables": {
			"patterns": [
				{
					"match": "(?<=(?:locals|inputs|dependency)\\s*=\\s*\\{)[^\\}]*\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\b(?=\\s*=)",
					"name": "variable.other.user-defined.hcl"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()",
					"name": "support.function.hcl"
				}
			]
		},
		"heredocs": {
			"patterns": [
				{
					"name": "string.quoted.heredoc.hcl",
					"begin": "<<-?([a-zA-Z_][a-zA-Z0-9_-]*)",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.heredoc.begin.hcl"
						}
					},
					"end": "\\1",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.heredoc.end.hcl"
						}
					},
					"patterns": [
						{
							"include": "#variables"
						},
						{
							"include": "#functions"
						}
					]
				}
			]
		}
	}
}
